# ─── GitHub App identity (from your App's settings page) ──────────────────────
GITHUB_APP_ID=123456
# The .pem you downloaded when creating the App. For local dev you can paste the
# raw PEM (keep the real newlines). For Fly.io secrets, base64-encode it:
#   base64 -i your-app.private-key.pem | tr -d '\n'
# config.ts accepts raw PEM, "\n"-escaped PEM, or base64 PEM.
GITHUB_APP_PRIVATE_KEY=
# The webhook secret you set when creating the App (any random string).
GITHUB_WEBHOOK_SECRET=

# ─── OpenRouter (the LLM that does the reviewing) ─────────────────────────────
OPENROUTER_API_KEY=
ASTER_BASE_URL=https://openrouter.ai/api/v1
# Model IDs are OpenRouter slugs — confirm current names at https://openrouter.ai/models
ASTER_MODEL=openai/gpt-4o-mini
ASTER_HYPOTHESIS_MODEL=openai/gpt-4o-mini
ASTER_VERIFY_MODEL=anthropic/claude-sonnet-4
ASTER_EFFORT=medium

# ─── Review behavior ─────────────────────────────────────────────────────────
# Drop findings below this confidence (0..1) before commenting.
MIN_CONFIDENCE=0.6

# Cost guard 1: re-review when new commits are pushed to a PR.
#   true  (default) = review on open AND on every push (synchronize)
#   false           = review once per PR (open / reopen / ready_for_review only)
REVIEW_ON_SYNCHRONIZE=true

# Cost guard 2: skip review for PRs whose changed lines (additions + deletions)
# exceed this. 0 = no limit. Try 1500 to avoid $1+ reviews on giant PRs.
MAX_DIFF_LINES=0
# Max concurrent aster runs on this instance.
REVIEW_CONCURRENCY=2
# Coalesce rapid pushes to the same PR within this window (ms).
REVIEW_DEBOUNCE_MS=8000
# Hard timeout for a single aster run (ms).
REVIEW_TIMEOUT_MS=900000

# Port the server listens on (Fly expects 8080).
PORT=8080
