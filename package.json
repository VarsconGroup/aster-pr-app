{
  "name": "aster-pr-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub App that reviews org PRs with aster (https://github.com/Zfinix/aster)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octokit/app": "^15.1.0",
    "@octokit/webhooks": "^13.3.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
